# ============ 持仓体检 PortfolioCheck 环境变量 ============
# 复制为 .env 后填写。所有凭证仅本地使用，绝不提交仓库。

# --- 数据源 1：扶摇（同花顺金融数据 API）---
# 获取方式：https://fuyao.aicubes.cn/admin 登录后「创建 API Key」
# 提供：行情快照、估值、财务、历史日线（相关性/波动率计算）
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn

# --- 数据源 2：iFinD MCP（可选，补充港美股/宏观/新闻）---
# 获取方式：浏览器登录 https://mcp.51ifind.com/?syncCookieTimes=1 创建 Key
IFIND_MCP_URL=
IFIND_MCP_TOKEN=

# --- AI 分析层（可选，缺省时使用规则模板降级）---
# 任意 Anthropic Messages API 兼容端点（直连或网关）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- 服务 ---
HOST=0.0.0.0
PORT=8000
# 数据新鲜度阈值（秒），超过则标记 stale
STALE_QUOTE_SECONDS=300
STALE_FINANCIAL_SECONDS=604800
STALE_KLINES_SECONDS=86400
